// AR2-DDCQG — Agentic, Retrieval-Augmented, Diagram-Driven Course Question Generation

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  runs         Run[]
  chatMessages ChatMessage[]
  agents       CustomAgent[]
  resets       PasswordReset[]
  apiKeys      UserApiKey[]
}

model Diagram {
  id        String   @id @default(cuid())
  filename  String
  mimeType  String
  dataUrl   String
  createdAt DateTime @default(now())
  runs      Run[]
}

model Run {
  id           String   @id @default(cuid())
  diagramId    String
  diagram      Diagram  @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  bloomLevel   String
  /// Number of questions to generate for this run. Null means "use the
  /// pipeline default" (4), preserving prior behavior for existing rows.
  questionCount Int?
  /// When true, the Generator Agent produces multiple-choice questions
  /// (with options + a correct answer index) instead of short-answer
  /// questions. Null/false = short-answer (prior default behavior).
  mcqOnly      Boolean?
  /// User-selected AI provider override (e.g. "gemini", "glm", "deepseek").
  /// Null means "let the pipeline auto-pick the default provider", same
  /// behavior as before this field existed.
  provider     String?
  status       String   @default("running")
  diagramType  String?
  extraction   String?
  questions    String?
  answers      String?
  verification String?
  finalQA      String?
  errorMessage String?
  /// Which pipeline stage was actually in flight when the run failed
  /// (extraction/generation/answering/verification/results). Used so a
  /// reconnecting client sees the error attributed to the right stage
  /// instead of always defaulting to "extraction".
  failedStage  String?
  startedAt    DateTime?
  completedAt  DateTime?
  durationMs   Int?
  folderId     String?
  folder       Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  questionsList Question[]
  studentAttempts StudentAttempt[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([diagramId])
  @@index([createdAt])
  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([folderId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  runId     String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  content   String
  createdAt DateTime @default(now())

  @@index([runId])
  @@index([userId])
  @@index([runId, userId, createdAt])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model CustomAgent {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  role        String
  prompt      String
  provider    String   @default("glm")
  model       String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([isPublic])
}

/// Per-account AI provider credentials. Two flavours, distinguished by
/// `isCustom`:
///
///  - Built-in override (isCustom = false): `providerId` matches one of the
///    fixed ProviderId values in src/lib/ai/providers.ts (e.g. "openai").
///    The user's own key/model takes priority over the platform's env-based
///    key whenever this row is present. One row per (userId, providerId).
///
///  - Custom provider (isCustom = true): a fully user-defined OpenAI-
///    compatible endpoint. `providerId` is a generated slug unique to this
///    row ("custom_<cuid>"), `label` is the human-facing provider name the
///    user chose, and `baseURL` + `model` are required. Referenced elsewhere
///    (Run.provider, CustomAgent.provider, chat `provider` option) as
///    `custom:<id>`.
model UserApiKey {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Built-in ProviderId for overrides; ignored (a fresh cuid is used) for custom providers.
  providerId String
  /// Display name. Required + user-chosen for custom providers; optional label for overrides.
  label      String?
  apiKey     String
  /// Required for custom providers (OpenAI-compatible chat/completions base URL).
  baseURL    String?
  /// Default model id to use with this key.
  model      String?
  isCustom   Boolean  @default(false)
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, providerId])
  @@index([userId])
  @@index([userId, isCustom])
}

model Folder {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  runs      Run[]
}

model Question {
  id                 String   @id @default(cuid())
  runId              String
  run                Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  bloomLevel         String
  type               String   // "MCQ", "SHORT", "TRUE_FALSE"
  text               String
  options            String?  // JSON stringified array for MCQ options
  answer             String
  explanation        String?
  verificationScore  Int?
  verificationVerdict String?
  isApproved         Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([runId])
}

model StudentAttempt {
  id         String   @id @default(cuid())
  runId      String
  run                Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  score      Int
  total      Int
  answers    String   // JSON stringified map of questionId -> studentAnswer
  createdAt  DateTime @default(now())

  @@index([runId])
}
